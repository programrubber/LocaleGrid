        <mxCell id="10" value="&lt;b&gt;1. 파일별 열기&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1E3A8A&quot;&gt;ko·en·ja·vi JSON을&lt;br&gt;각각 탐색&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Apple SD Gothic Neo;fontSize=17;fontColor=#1E3A8A;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;spacing=8;" vertex="1" parent="5">
