        <mxCell id="11" value="&lt;b&gt;2. key 수동 대조&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#1E3A8A&quot;&gt;같은 key 위치를&lt;br&gt;파일마다 확인&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Apple SD Gothic Neo;fontSize=17;fontColor=#1E3A8A;fillColor=#FFFFFF;strokeColor=#1E3A8A;strokeWidth=2;spacing=8;" vertex="1" parent="5">
